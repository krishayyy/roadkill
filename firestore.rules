rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Only allow fields that actually exist on EcilyUser — reject unexpected keys
    function hasOnlyUserFields() {
      let allowed = [
        'uid','name','email','age','state','moneySituation','goals',
        'explanationStyle','colorScheme','accentTheme','birthday',
        'xp','level','streak','lastActiveDate','completedLessons',
        'worldProgress','portfolio','sandbox','ecilyCoins',
        'unlockedCosmetics','equippedSkin','streakFreezeCount','watchlist',
        'ownedShopItemIDs','hasXPBoost','username','friendIDs',
        'pendingFriendRequests','isLeaderboardPublic','activeChallengeIDs',
        'role','classroomCode','ownClassroomCode','isOnboardingComplete',
        'joinDate','savedCilyMessages','recommendedWorldOrder',
        'personalizedWelcomeMessage','lessonSummaries','learningArc',
        'currentLessonID','currentWorldID','chosenWorldID','blockedUIDs',
        'reviewState','bestStreak'
      ];
      return request.resource.data.keys().hasOnly(allowed);
    }

    // COPPA / minors age gate — block accounts for under-13 users at the source.
    function passesAgeGate() {
      return request.resource.data.age is int
             && request.resource.data.age >= 13;
    }

    // Only the listed key(s) changed between the old and new doc.
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A uid-array field changed by exactly one element — the caller's own uid —
    // either added (join) or removed (leave). Nothing else may change.
    function selfOnlyArrayDelta(before, after) {
      return (after.toSet().difference(before.toSet()) == [request.auth.uid].toSet()
              && before.toSet().difference(after.toSet()).size() == 0)
          || (before.toSet().difference(after.toSet()) == [request.auth.uid].toSet()
              && after.toSet().difference(before.toSet()).size() == 0);
    }

    // A uid-array field gained exactly the caller's uid and lost nothing (join-only).
    function selfOnlyArrayAdd(before, after) {
      return after.toSet().difference(before.toSet()) == [request.auth.uid].toSet()
          && before.toSet().difference(after.toSet()).size() == 0;
    }

    // A friend-request list gained exactly ONE entry, at the END of the list,
    // and that entry identifies the caller: id == request.auth.uid, only the
    // expected keys, display strings capped. Nothing was removed or replaced,
    // so a requester can never wipe/reorder someone's inbox — and can never
    // forge an entry that impersonates another user.
    // (Pinning the appended entry to the last slot is what lets rules inspect
    // a map inside an array: the set-diff proves the last element is the only
    // new one, then its fields are validated directly.)
    function validFriendRequestAppend(before, after) {
      let entry = after[after.size() - 1];
      return after.size() == before.size() + 1
          && before.toSet().difference(after.toSet()).size() == 0
          && after.toSet().difference(before.toSet()) == [entry].toSet()
          && entry.keys().hasOnly(['id', 'displayName', 'username', 'sentAt'])
          && entry.id == request.auth.uid
          && entry.displayName is string
          && entry.displayName.size() > 0
          && entry.displayName.size() <= 60
          && entry.username is string
          && entry.username.size() <= 40
          && entry.sentAt is timestamp;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Only the authenticated owner can read their own doc.
      allow read:  if isOwner(uid);
      // Create requires the owner, a valid field set, and a 13+ age gate.
      // The gate applies to updates too so age can't be lowered after signup.
      allow create: if isOwner(uid) && hasOnlyUserFields() && passesAgeGate();
      allow update: if isOwner(uid) && hasOnlyUserFields() && passesAgeGate();
      allow delete: if isOwner(uid);

      // Friends/classmates write to each other's social arrays only.
      // - sendFriendRequest: a signed-in user appends to a target's pendingFriendRequests.
      // - acceptFriendRequest/removeFriend: mutual friendIDs arrayUnion/arrayRemove.
      // - joinClassroom: a student is not the user here; classroom doc holds the roster.
      // These cross-user writes are limited to the social array fields, never the
      // whole document, so a peer can never overwrite balances, XP, or PII.
      //
      // friendIDs: a peer may only add or remove THEIR OWN uid (mutual
      // accept/remove writes one uid per doc — see SocialService).
      // pendingFriendRequests: a peer may only APPEND one validated request
      // entry whose id IS their own uid (see validFriendRequestAppend) — a
      // peer can't forge a request from someone else or inject an oversized
      // display name into a minor's UI. Removal happens on the owner's own
      // doc via the owner rule. Array caps prevent storage-bloat / DoS abuse.
      allow update: if isSignedIn()
                    && request.auth.uid != uid
                    && (
                         (onlyChanged(['friendIDs'])
                          && request.resource.data.friendIDs.size() <= 2000
                          && selfOnlyArrayDelta(
                               resource.data.get('friendIDs', []),
                               request.resource.data.friendIDs))
                         ||
                         (onlyChanged(['pendingFriendRequests'])
                          && request.resource.data.pendingFriendRequests.size() <= 200
                          && validFriendRequestAppend(
                               resource.data.get('pendingFriendRequests', []),
                               request.resource.data.pendingFriendRequests))
                       );

      // Personalization cache — only the owner
      match /personalization_cache/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Usernames (public lookup index) ───────────────────────────────────
    // Owner-maintained public profile snapshot used for friend search and the
    // friends list — { uid, username, displayName, level, streak }. The doc ID
    // IS the handle, which is what enforces uniqueness. Handle format mirrors
    // the client filter: lowercase letters, digits, underscore, 3-20 chars.
    match /usernames/{username} {
      function validUsernameDoc() {
        return request.resource.data.keys().hasOnly(
                 ['uid','username','displayName','level','streak'])
               && request.resource.data.uid == request.auth.uid
               && request.resource.data.username == username
               && username.matches('^[a-z0-9_]{3,20}$')
               && request.resource.data.displayName is string
               && request.resource.data.displayName.size() <= 60
               && request.resource.data.level is int
               && request.resource.data.level >= 0
               && request.resource.data.streak is int
               && request.resource.data.streak >= 0;
      }

      allow read:   if isSignedIn();
      allow create: if isSignedIn() && validUsernameDoc();
      // Owner may refresh their snapshot but can never hand the handle to
      // another uid — uid is pinned on both sides of the write.
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && validUsernameDoc();
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // ── Leaderboard (public read, owner write) ────────────────────────────
    // Fields match SocialService.publishToLeaderboard exactly. The doc ID is the
    // uid; 'uid' is allowed in case a payload ever carries it explicitly.
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      // Every field is broadcast to all signed-in users, so validate types and
      // bounds: no megabyte strings, no absurd forged returns.
      allow write: if isOwner(uid)
                   && request.resource.data.keys().hasOnly(
                        ['uid','displayName','username','returnPct',
                         'streak','level','updatedAt']
                      )
                   && request.resource.data.displayName is string
                   && request.resource.data.displayName.size() <= 60
                   && request.resource.data.username is string
                   && request.resource.data.username.size() <= 40
                   && request.resource.data.returnPct is number
                   && request.resource.data.returnPct >= -100
                   && request.resource.data.returnPct <= 10000
                   && request.resource.data.streak is int
                   && request.resource.data.streak >= 0
                   && request.resource.data.streak <= 36500
                   && request.resource.data.level is int
                   && request.resource.data.level >= 0
                   && request.resource.data.level <= 10000;
      allow delete: if isOwner(uid);
    }

    // ── Classrooms ────────────────────────────────────────────────────────
    // Doc ID is the join code. The teacher (teacherUID) owns the classroom;
    // enrolled students may read it. Students self-enroll/unenroll by mutating
    // ONLY the studentUIDs roster (arrayUnion on join, arrayRemove on leave).
    match /classrooms/{code} {
      function isTeacher() {
        return isSignedIn() && resource.data.teacherUID == request.auth.uid;
      }
      function isEnrolledStudent() {
        return isSignedIn() && request.auth.uid in resource.data.studentUIDs;
      }

      allow read: if isTeacher() || isEnrolledStudent();

      // Teacher creates the room and must own it.
      allow create: if isSignedIn()
                    && request.resource.data.teacherUID == request.auth.uid;

      // Teacher may update/delete the room they own.
      allow update: if isTeacher();
      allow delete: if isTeacher();

      // A student may join/leave by changing ONLY the roster, and the only
      // element added or removed across the whole write is THEIR OWN uid —
      // a joiner cannot simultaneously evict other students.
      allow update: if isSignedIn()
                    && onlyChanged(['studentUIDs'])
                    // Cap roster size to prevent unbounded array growth / billing abuse.
                    && request.resource.data.studentUIDs.size() <= 250
                    && selfOnlyArrayDelta(resource.data.studentUIDs,
                                          request.resource.data.studentUIDs);
    }

    // ── Challenges (1v1 trading duels) ────────────────────────────────────
    // Only the creator and the opponent may read or write the challenge doc.
    match /challenges/{challengeID} {
      function isParticipant() {
        return isSignedIn()
               && (resource.data.creatorID == request.auth.uid
                   || resource.data.opponentID == request.auth.uid);
      }

      // Fields match StockChallenge (SocialModels.swift) exactly.
      function hasOnlyChallengeFields() {
        return request.resource.data.keys().hasOnly([
          'creatorID','creatorName','creatorUsername',
          'opponentID','opponentName','opponentUsername',
          'startingAmount','durationDays','targetReturnPct','message',
          'status','createdAt','startedAt','endsAt',
          'creatorPortfolio','opponentPortfolio','winnerID'
        ]);
      }

      // A brand-new challenge portfolio: all cash, no positions. Blocks a
      // tampered client from opening a duel pre-loaded with forged holdings.
      function freshPortfolio(p, startingAmount) {
        return p.keys().hasOnly(['cash','holdings'])
               && p.cash == startingAmount
               && p.holdings is list
               && p.holdings.size() == 0;
      }

      allow read: if isParticipant();

      // Creator opens the challenge and must be the creator. Both portfolios
      // must be fresh and there can be no pre-declared winner — everything
      // that moves money afterwards goes through the executeTrade Cloud
      // Function, which prices trades server-side.
      allow create: if isSignedIn()
                    && hasOnlyChallengeFields()
                    && request.resource.data.creatorID == request.auth.uid
                    && request.resource.data.opponentID is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.startingAmount is number
                    && request.resource.data.startingAmount > 0
                    && request.resource.data.startingAmount <= 10000000
                    && freshPortfolio(request.resource.data.creatorPortfolio,
                                      request.resource.data.startingAmount)
                    && freshPortfolio(request.resource.data.opponentPortfolio,
                                      request.resource.data.startingAmount)
                    && !request.resource.data.keys().hasAny(['winnerID'])
                    // message is optional trash-talk; cap it when present
                    && (!request.resource.data.keys().hasAny(['message'])
                        || (request.resource.data.message is string
                            && request.resource.data.message.size() <= 200));

      // Clients may only accept or decline a pending challenge. Trades,
      // mark-to-market, and settlement are executed server-side by the
      // executeTrade Cloud Function (Admin SDK bypasses these rules), so
      // portfolios, winnerID, and completion can never be forged by a
      // modified client — that's what keeps duel prices honest.
      allow update: if isParticipant()
                    && hasOnlyChallengeFields()
                    && onlyChanged(['status','startedAt','endsAt'])
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['active','declined'];
      allow delete: if isParticipant();
    }

    // ── Playlists (stock playlists) ───────────────────────────────────────
    // Owner has full control. Public playlists are readable by any signed-in
    // user (Discover/trending feed). Non-owners may only follow/unfollow by
    // toggling THEIR OWN uid in followerUIDs.
    match /playlists/{playlistID} {
      function isPlaylistOwner() {
        return isSignedIn() && resource.data.ownerUID == request.auth.uid;
      }

      allow read: if isSignedIn()
                  && (resource.data.isPublic == true
                      || resource.data.ownerUID == request.auth.uid);

      allow create: if isSignedIn()
                    && request.resource.data.ownerUID == request.auth.uid;

      allow update: if isPlaylistOwner();
      allow delete: if isPlaylistOwner();

      // Follow/unfollow: change ONLY followerUIDs, and the only element added
      // or removed is the caller's own uid — a follower cannot wipe the list.
      allow update: if isSignedIn()
                    && onlyChanged(['followerUIDs'])
                    && request.resource.data.followerUIDs.size() <= 50000
                    && selfOnlyArrayDelta(resource.data.get('followerUIDs', []),
                                          request.resource.data.followerUIDs);
    }

    // ── Trading Leagues (fantasy leagues) ─────────────────────────────────
    // The commissioner owns the league; current members may read it. The
    // commissioner writes league-level state (start season, settle weeks). A
    // signed-in user may join by adding ONLY their own uid to memberIDs (and
    // their display-name/username map entries).
    match /leagues/{leagueID} {
      function isCommissioner() {
        return isSignedIn() && resource.data.commissionerUID == request.auth.uid;
      }
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIDs;
      }

      allow read: if isCommissioner() || isMember();

      // Commissioner creates the league and must be its commissioner + first member.
      allow create: if isSignedIn()
                    && request.resource.data.commissionerUID == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIDs;

      // Commissioner controls full league lifecycle.
      allow update: if isCommissioner();
      allow delete: if isCommissioner();

      // Join: a new member adds ONLY their own uid to memberIDs and their
      // own entries in the display-name / username maps. They cannot remove
      // existing members or alter league configuration.
      // The join write sets memberDisplayNames.{uid} and memberUsernames.{uid}
      // (see SocialService.joinLeague). Validate that those map entries are
      // strings of sane length so a peer can't inject oversized/garbage values.
      allow update: if isSignedIn()
                    && !(request.auth.uid in resource.data.memberIDs)
                    && onlyChanged(['memberIDs', 'memberDisplayNames', 'memberUsernames'])
                    // The roster gains exactly this user and loses nobody.
                    && selfOnlyArrayAdd(resource.data.memberIDs,
                                        request.resource.data.memberIDs)
                    && request.resource.data.memberIDs.size() <= 100
                    // Only their own map entries may change.
                    && request.resource.data.memberDisplayNames
                         .diff(resource.data.get('memberDisplayNames', {}))
                         .affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.memberUsernames
                         .diff(resource.data.get('memberUsernames', {}))
                         .affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.memberDisplayNames[request.auth.uid] is string
                    && request.resource.data.memberDisplayNames[request.auth.uid].size() <= 60
                    && request.resource.data.memberUsernames[request.auth.uid] is string
                    && request.resource.data.memberUsernames[request.auth.uid].size() <= 40;

      // ── Members subcollection ──────────────────────────────────────────
      // Each member doc is keyed by uid. A member reads all members
      // (standings) but can NO LONGER write their own doc: trades go through
      // the executeTrade Cloud Function, which resolves the market price
      // server-side and writes with the Admin SDK — so a tampered client
      // cannot fabricate fill prices that decide weekly matchups. The
      // commissioner may still write member docs (weekly settlement updates
      // wins/losses/weekStartValue and marks portfolios to market).
      match /members/{memberUID} {
        function leagueData() {
          return get(/databases/$(database)/documents/leagues/$(leagueID)).data;
        }

        allow read: if isSignedIn()
                    && request.auth.uid in leagueData().memberIDs;

        // Join: a member creates ONLY their own stats doc, seeded fresh —
        // the portfolio starts at the league's startingCash with no holdings
        // and a clean record, so nobody joins pre-loaded.
        allow create: if isOwner(memberUID)
                      && request.auth.uid in leagueData().memberIDs
                      && request.resource.data.portfolio.cash == leagueData().startingCash
                      && request.resource.data.portfolio.holdings is list
                      && request.resource.data.portfolio.holdings.size() == 0
                      && request.resource.data.wins == 0
                      && request.resource.data.losses == 0
                      && request.resource.data.weekStartValue == leagueData().startingCash;

        allow update, delete: if isSignedIn()
                              && leagueData().commissionerUID == request.auth.uid;
      }

      // ── Matchups subcollection ─────────────────────────────────────────
      // Members read their league's matchups; only the commissioner writes
      // (created/scored during season start and weekly settlement).
      match /matchups/{matchupID} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(
                         /databases/$(database)/documents/leagues/$(leagueID)
                       ).data.memberIDs;

        allow write: if isSignedIn()
                     && get(/databases/$(database)/documents/leagues/$(leagueID))
                          .data.commissionerUID == request.auth.uid;
      }
    }

    // ── Reports (user-generated-content reports) ──────────────────────────
    // Write-only drop box: any signed-in user may file a report about another
    // user; nobody can read, edit, or delete them from the client. Reviewed
    // via the Firebase console / admin tooling.
    match /reports/{reportID} {
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(
                         ['reporterUID','reportedUID','reportedUsername',
                          'reason','context','createdAt'])
                    && request.resource.data.reporterUID == request.auth.uid
                    && request.resource.data.reportedUID is string
                    && request.resource.data.reportedUID.size() <= 128
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 100
                    && request.resource.data.context is string
                    && request.resource.data.context.size() <= 500;
      allow read, update, delete: if false;
    }

    // ── WildlifeAlert: wildlifeHotspots (public read-only corridor data) ──
    // Seeded out-of-band via the Firebase MCP/admin tooling with real
    // FHWA/state-DOT-documented collision corridors (see `source` field on
    // each doc). No client-side auth in this hackathon app, so reads are
    // open; writes are intentionally NOT allowed from the client — only an
    // authenticated admin/maintainer reseeds this collection.
    match /wildlifeHotspots/{hotspotID} {
      allow read: if true;
      allow write: if false;
    }

    // ── WildlifeAlert: sightings (crowdsourced reports) ───────────────────
    // Any client may append a sighting report (no destructive read-back of
    // others' reports needed by the app, and no auth system in this demo).
    // Validated to the exact shape FirestoreManager.reportSighting writes,
    // capped so a malicious client can't stuff arbitrary large payloads.
    match /sightings/{sightingID} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['latitude','longitude','species','timestamp','reportedByDevice'])
                    && request.resource.data.latitude is number
                    && request.resource.data.latitude >= -90
                    && request.resource.data.latitude <= 90
                    && request.resource.data.longitude is number
                    && request.resource.data.longitude >= -180
                    && request.resource.data.longitude <= 180
                    && request.resource.data.species is string
                    && request.resource.data.species.size() <= 40
                    && request.resource.data.timestamp is timestamp
                    && request.resource.data.reportedByDevice is string
                    && request.resource.data.reportedByDevice.size() <= 64;
      allow update, delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
